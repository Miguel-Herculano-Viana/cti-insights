# Copie para backend/.env e preencha.

# Neon: do link postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
# tire usuário e senha e coloque "jdbc:" na frente:
DB_URL=jdbc:postgresql://ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=sua-senha

# Invente um segredo com pelo menos 32 caracteres
JWT_SEGREDO=invente-um-segredo-bem-grande-com-32-caracteres

# Endereço do front (local e, depois, o da Vercel)
CORS_ORIGENS=http://localhost:5173

# Admin criado sozinho na primeira vez que o backend sobe
ADMIN_EMAIL=admin@cti.local
ADMIN_SENHA=Admin@12345

# API Python (FastAPI)
PYTHON_URL=http://localhost:8000
PYTHON_CHAVE=troque-esta-chave
